ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/brokerage_crm
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-32-byte-random-secret
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-compatible-key
WEBHOOK_SIGNING_SECRET=replace-with-a-long-provider-webhook-secret
CORS_ORIGINS=["http://localhost:3000"]
PORT=8000
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
